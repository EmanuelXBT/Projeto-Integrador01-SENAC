# ============================================
# QAwler — Variáveis de Ambiente
# ============================================
# Copie este arquivo para .env e preencha os valores
# cp .env.example .env
# ============================================

# --- Banco de Dados (MySQL 8) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=qawler
DB_USER=qawler_user
DB_PASS=change_me

# --- JWT ---
JWT_SECRET=coloque-aqui-uma-chave-secreta-de-pelo-menos-256-bits
JWT_EXPIRATION_MS=86400000

# --- RabbitMQ ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_QUEUE=qawler.scans

# --- Selenium / Crawler ---
SELENIUM_HEADLESS=true
SELENIUM_TIMEOUT_SECONDS=30
CRAWLER_MAX_DEPTH=2
CRAWLER_USER_AGENT=QAwler/1.0 (QA Crawler; +https://github.com/EmanuelXBT/Projeto-Integrador01-SENAC)

# --- SMTP (envio de e-mails) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app
SMTP_FROM=noreply@qawler.local

# --- AES-256 (credenciais de sistemas) ---
AES_SECRET_KEY=coloque-aqui-uma-chave-aes-de-256-bits-em-base64
